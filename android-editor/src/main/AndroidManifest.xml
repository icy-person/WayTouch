<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.waytouch.editor"
    android:versionCode="4"
    android:versionName="2.1.1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="32" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_waytouch"
        android:roundIcon="@drawable/ic_waytouch"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shell-only token bootstrap. The activity forwards the token to the
             private EditorService, so app UI and notification actions can still
             start that service without the privileged DUMP permission. -->
        <activity
            android:name=".BootstrapActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <service
            android:name=".EditorService"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
